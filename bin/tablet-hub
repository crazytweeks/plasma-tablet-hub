#!/usr/bin/env python3
"""tablet-hub: a system-tray control panel for using this 2-in-1 as a tablet.

Hub for the user-space daemons that make a convertible laptop usable in tablet
mode:

  * tablet-keyboard-guard : disables the built-in keyboard while folded
  * pen-scroll            : configurable stylus buttons + drag scrolling
  * tabhub-gestures       : 3/4/5-finger touchscreen gestures

Tap the tray icon for a finger-sized panel; right-click for the compact menu.
All privileged/service work runs off the GUI thread, so the panel never freezes.
User-space only; the single privileged action is retiring a legacy root
pen-scroll.service.

Config: ~/.config/tablet-hub/config.json
"""
from __future__ import annotations

import glob
import json
import os
import subprocess
import sys
import threading

from PyQt6.QtCore import QObject, QRectF, QSize, Qt, QTimer, pyqtSignal
